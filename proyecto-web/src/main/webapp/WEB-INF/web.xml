<?xml version="1.0" encoding="UTF-8"?>
<!-- Descriptor web de uniMotor: JSF 2.3 (Mojarra) + PrimeFaces 8 sobre Payara 5 (local) o TomEE 8 Plume (demo publicada) -->
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	id="WebApp_ID" version="4.0">
	<display-name>proyecto-web</display-name>

	<!-- Peticiones y respuestas en UTF-8 en cualquier servidor (Servlet 4.0). En Payara lo hace tambien
	     glassfish-web.xml; en TomEE/Tomcat los formularios sin AJAX llegarian en ISO-8859-1 sin esto -->
	<request-character-encoding>UTF-8</request-character-encoding>
	<response-character-encoding>UTF-8</response-character-encoding>

	<!-- Pagina de inicio -->
	<welcome-file-list>
		<welcome-file>index.xhtml</welcome-file>
	</welcome-file-list>

	<!-- Servlet de JSF -->
	<servlet>
		<servlet-name>Faces Servlet</servlet-name>
		<servlet-class>javax.faces.webapp.FacesServlet</servlet-class>
		<load-on-startup>1</load-on-startup>
		<!-- Subida de archivos (fotos de vehiculos) con el subidor nativo de Servlet 3.
		     El esquema exige este orden: max-file-size, max-request-size, file-size-threshold. -->
		<multipart-config>
			<max-file-size>5242880</max-file-size>
			<max-request-size>62914560</max-request-size>
			<file-size-threshold>0</file-size-threshold>
		</multipart-config>
	</servlet>
	<servlet-mapping>
		<servlet-name>Faces Servlet</servlet-name>
		<url-pattern>*.xhtml</url-pattern>
	</servlet-mapping>

	<!-- Parametros de JSF -->
	<context-param>
		<param-name>javax.faces.PROJECT_STAGE</param-name>
		<param-value>Development</param-value>
	</context-param>
	<context-param>
		<param-name>javax.faces.FACELETS_SKIP_COMMENTS</param-name>
		<param-value>true</param-value>
	</context-param>
	<context-param>
		<param-name>javax.faces.DATETIMECONVERTER_DEFAULT_TIMEZONE_IS_SYSTEM_TIMEZONE</param-name>
		<param-value>true</param-value>
	</context-param>

	<!-- Parametros de PrimeFaces (temas incluidos en la 8.0: nova-light/dark/colored, luna-*, omega, aristo) -->
	<context-param>
		<param-name>primefaces.THEME</param-name>
		<param-value>nova-light</param-value>
	</context-param>
	<context-param>
		<param-name>primefaces.UPLOADER</param-name>
		<param-value>native</param-value>
	</context-param>
	<context-param>
		<param-name>primefaces.FONT_AWESOME</param-name>
		<param-value>true</param-value>
	</context-param>

	<!-- Paginas de error (el FacesServlet atiende *.xhtml, por eso las rutas terminan en .xhtml) -->
	<error-page>
		<error-code>404</error-code>
		<location>/noEncontrado.xhtml</location>
	</error-page>
	<error-page>
		<error-code>500</error-code>
		<location>/error.xhtml</location>
	</error-page>
	<!-- Sin mapeo para java.lang.Throwable a proposito: el FacesServlet envuelve las excepciones en una
	     ServletException y Payara la compararia con Throwable antes de desenvolverla, de modo que
	     ViewExpiredException nunca llegaria a su pagina. Las demas excepciones salen como 500 -> error.xhtml -->
	<error-page>
		<exception-type>javax.faces.application.ViewExpiredException</exception-type>
		<location>/sesionExpirada.xhtml</location>
	</error-page>

	<!-- Tipos MIME de las fuentes de PrimeFaces y FontAwesome (sin esto JSF avisa JSF1091 en el log) -->
	<mime-mapping>
		<extension>ttf</extension>
		<mime-type>font/ttf</mime-type>
	</mime-mapping>
	<mime-mapping>
		<extension>woff</extension>
		<mime-type>font/woff</mime-type>
	</mime-mapping>
	<mime-mapping>
		<extension>woff2</extension>
		<mime-type>font/woff2</mime-type>
	</mime-mapping>
	<mime-mapping>
		<extension>eot</extension>
		<mime-type>application/vnd.ms-fontobject</mime-type>
	</mime-mapping>
	<mime-mapping>
		<extension>otf</extension>
		<mime-type>font/otf</mime-type>
	</mime-mapping>

	<!-- Caducidad de la sesion: 30 minutos de inactividad -->
	<session-config>
		<session-timeout>30</session-timeout>
	</session-config>
</web-app>
