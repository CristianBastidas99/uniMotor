<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="raiz" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.unimotor.escritorio.controlador.PrincipalController">
	<top>
		<HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="barra-superior">
			<padding>
				<Insets bottom="10.0" left="16.0" right="16.0" top="10.0" />
			</padding>
			<children>
				<Label styleClass="titulo" text="uniMotor — Estadísticas" />
				<Region HBox.hgrow="ALWAYS" />
				<Label fx:id="etiquetaUsuario" text="Administrador" />
				<Button fx:id="botonRefrescar" mnemonicParsing="false" onAction="#refrescar" styleClass="boton-secundario" text="Refrescar" />
				<Button fx:id="botonCerrarSesion" mnemonicParsing="false" onAction="#cerrarSesion" styleClass="boton-secundario" text="Cerrar sesión" />
			</children>
		</HBox>
	</top>
	<left>
		<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="270.0" style="-fx-background-color: #1f3a5f; -fx-background: #1f3a5f;" BorderPane.alignment="CENTER">
			<content>
				<VBox fx:id="menu" spacing="4.0" styleClass="menu-lateral">
					<padding>
						<Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
					</padding>
				</VBox>
			</content>
		</ScrollPane>
	</left>
	<center>
		<StackPane fx:id="contenedorGrafico" styleClass="contenido" BorderPane.alignment="CENTER">
			<padding>
				<Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
			</padding>
		</StackPane>
	</center>
	<bottom>
		<HBox alignment="CENTER_LEFT" styleClass="barra-estado">
			<padding>
				<Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
			</padding>
			<children>
				<Label fx:id="estado" text="Cargando datos..." HBox.hgrow="ALWAYS" />
			</children>
		</HBox>
	</bottom>
</BorderPane>
