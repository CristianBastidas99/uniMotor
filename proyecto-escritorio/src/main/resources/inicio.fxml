<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="420.0" styleClass="raiz" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.unimotor.escritorio.controlador.InicioController">
	<padding>
		<Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
	</padding>
	<children>
		<VBox alignment="CENTER" maxWidth="340.0" spacing="14.0" styleClass="tarjeta-login">
			<padding>
				<Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
			</padding>
			<children>
				<Label styleClass="titulo" text="uniMotor" />
				<Label styleClass="subtitulo" text="Panel del administrador">
					<VBox.margin>
						<Insets bottom="10.0" />
					</VBox.margin>
				</Label>
				<TextField fx:id="cajonEmail" maxWidth="280.0" prefWidth="280.0" promptText="Email" styleClass="campo" />
				<PasswordField fx:id="cajonPassword" maxWidth="280.0" prefWidth="280.0" promptText="Contraseña" styleClass="campo" />
				<Button fx:id="botonIngresar" defaultButton="true" maxWidth="280.0" mnemonicParsing="false" onAction="#ingresar" prefWidth="280.0" styleClass="boton-primario" text="Iniciar sesión" />
				<Label fx:id="mensaje" maxWidth="280.0" styleClass="mensaje-error" wrapText="true" />
				<Hyperlink fx:id="enlaceRecuperar" onAction="#recuperarPassword" styleClass="enlace" text="¿Olvidó su contraseña?" />
			</children>
		</VBox>
	</children>
</VBox>
